<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jinxu.okx-monitor.alerts</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd '/Users/jinxu/.openclaw/workspace】/okx-monitor' && source '/Users/jinxu/.openclaw/workspace】/maco-news-bot/.env' && python3 push_alerts.py >> '/Users/jinxu/.openclaw/workspace】/okx-monitor/alerts.log' 2>&1</string>
